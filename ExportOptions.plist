<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For TestFlight builds: xcodebuild -exportArchive -exportOptionsPlist ExportOptions.plist.
     destination "export" writes an .ipa locally; switch to "upload" to send it to App Store Connect. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>Y837X7M3W4</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
